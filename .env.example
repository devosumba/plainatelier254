# ─────────────────────────────────────────────────────────
# Watendawili Shop — Environment Variables Reference
# Copy to .env.local and fill in real values
# .env.local must NEVER be committed to git
# ─────────────────────────────────────────────────────────

# SITE URL (public — used to build absolute URLs like the PayHero webhook callback)
# Not sensitive: this is baked into the client bundle and safe to expose.
NEXT_PUBLIC_SITE_URL=https://watendawili.com

# PAYHERO M-PESA (SENSITIVE — server-side only, never expose to the browser)
# Used by app/api/checkout/stk-push to trigger an M-Pesa STK push on checkout.
# Get these from your PayHero account dashboard.
PAYHERO_USERNAME=replace_with_payhero_username
PAYHERO_PASSWORD=replace_with_payhero_password
PAYHERO_CHANNEL_ID=replace_with_numeric_channel_id

# Optional — defaults to https://backend.payhero.co.ke/api/v2/payments if unset
PAYHERO_ENDPOINT=https://backend.payhero.co.ke/api/v2/payments

# PAYHERO WEBHOOK (SENSITIVE — server-side only)
# Used by app/api/payhero/webhook to verify that a payment callback really
# came from PayHero, if your PayHero account has a webhook secret configured.
# Leave unset to skip signature verification (not recommended once you have one).
PAYHERO_WEBHOOK_SECRET=

# DATABASE (SENSITIVE — server-side only, never expose to the browser)
# Postgres connection string for order persistence (lib/db.ts, lib/orders.ts).
# Connect a Postgres database (Neon) to this project in the Vercel dashboard's
# Storage tab — it injects DATABASE_URL automatically. For local development,
# run `vercel env pull .env.development.local` to pull the same value down.
DATABASE_URL=

# RESEND EMAIL (SENSITIVE — server-side only, never expose to the browser)
# Used by app/api/payhero/webhook to send an order confirmation email to the
# customer and to watendawilibookings@gmail.com once PayHero confirms payment.
# Get this from your Resend account dashboard.
RESEND_API_KEY=replace_with_resend_api_key

# Optional — defaults to "Watendawili <onboarding@resend.dev>" if unset.
# Switch to a verified sending domain once one is set up in Resend.
RESEND_FROM=Watendawili <onboarding@resend.dev>

# TEMPORARY / TEST ONLY — not sensitive, defaults to off.
# When "true", the STK push and webhook routes skip all database reads and
# writes, isolating the PayHero flow for debugging. Never enable in normal
# production use. Strip this out (and its two usages) once the STK push and
# webhook are confirmed working independently of the database.
SKIP_DB_PERSISTENCE=false
